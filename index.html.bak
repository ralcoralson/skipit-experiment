<script src="main.js"></script>
<script>
  // Simple check for locally stored user (set by auth.html)
  const _user = localStorage.getItem('skipit_user');
  const loginBtn = document.getElementById('navLoginBtn');
  const userMenu = document.getElementById('navUserMenu');
  const avatar = document.getElementById('navAvatar');

  if (_user) {
    try {
      const u = JSON.parse(_user);
      if (u && u.uid) {
        if (loginBtn) loginBtn.style.display = 'none';
        if (userMenu) userMenu.style.display = 'flex';
        const n = u.name || u.email || 'U';
        if (avatar) avatar.textContent = n.charAt(0).toUpperCase();

        const dashAvatar = document.getElementById('dashAvatar');
        const dashName = document.getElementById('dashName');
        const dashEmail = document.getElementById('dashEmail');
        if (dashAvatar) dashAvatar.textContent = n.charAt(0).toUpperCase();
        if (dashName) dashName.textContent = u.name || 'SkipIt Member';
        if (dashEmail) dashEmail.textContent = u.email || 'user@example.com';
      }
    } catch(e){}
  }

  window.logoutUser = () => {
    localStorage.removeItem('skipit_user');
    window.location.reload();
  };

  window.checkAuthThenRent = () => {
    if (!localStorage.getItem('skipit_user')) {
      alert('Please sign in or create an account to complete your rental booking!');
      window.location.href = 'auth.html';
    } else {
      alert('🎉 Rental request submitted successfully! The owner will be notified to coordinate handover.');
      closeListingModal();
    }
  };
</script>
</body>
</html>