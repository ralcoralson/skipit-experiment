// ============================================================
// RENDER PRODUCT CARDS (HIGH CONTRAST)
// ============================================================
function renderProductCard(p) {
  const initials = p.owner.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
  return `
    <div class="product-card reveal" data-category="${p.catKey}" data-location="${p.location}" onclick="openListingModal(window._products['${p.id}'])">
      <div class="product-card-image">
        <img src="${p.image}" alt="${p.title}" loading="lazy">
        <div class="product-card-status">
          <span class="badge badge--green">
            <svg viewBox="0 0 8 8" fill="currentColor" style="width:7px;height:7px"><circle cx="4" cy="4" r="3"/></svg>
            ${p.status}
          </span>
        </div>
        <button class="product-card-wishlist" aria-label="Save listing" onclick="event.stopPropagation(); this.classList.toggle('saved');">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
      </div>
      <div class="product-card-body">
        <div class="product-card-meta">
          <div class="product-card-location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            ${p.location}
          </div>
          <div class="product-card-rating">
            <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ${p.rating}
          </div>
        </div>
        <div class="product-card-title">${p.title}</div>
        <div class="product-card-owner">
          <div class="owner-avatar">${initials}</div>
          <span class="product-card-owner-name">${p.owner}</span>
          <div class="owner-verified">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Verified
          </div>
        </div>
        <div class="product-card-footer">
          <div class="product-card-price">
            <div class="product-price-main">${p.price}</div>
            <div class="product-price-per">per day</div>
          </div>
          <button class="btn btn--primary btn--sm" onclick="event.stopPropagation(); openListingModal(window._products['${p.id}'])">
            Rent Now →
          </button>
        </div>
      </div>
    </div>
  `;
}

function renderListings(list) {
  const listingsGrid = document.getElementById('listingsGrid');
  if (!listingsGrid) return;

  if (list.length === 0) {
    listingsGrid.innerHTML = `
      <div style="grid-column: 1 / -1; text-align: center; padding: 64px 20px; background: var(--glass-card); border-radius: var(--radius-2xl); border: 1px solid var(--glass-border);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:48px;height:48px;color:var(--text-muted);margin:0 auto 16px"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <h3 style="font-size:1.25rem;font-weight:700;margin-bottom:8px;color:#fff">No listings found</h3>
        <p style="color:var(--text-secondary);margin-bottom:20px;max-width:400px;margin-left:auto;margin-right:auto">Try changing your search terms, removing filters, or searching in a different city.</p>
        <button class="btn btn--primary" onclick="resetFilters()">Reset All Filters</button>
      </div>
    `;
    return;
  }

  listingsGrid.innerHTML = list.map(renderProductCard).join('');
  listingsGrid.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
}

// Initial render
renderListings(products);

// ============================================================
// DYNAMIC SEARCH & FILTERING
// ============================================================
window.filterMarketplace = () => {
  const keyword = (document.getElementById('mainSearchKeyword')?.value || '').toLowerCase().trim();
  const cat = (document.getElementById('mainSearchCat')?.value || 'all').toLowerCase();
  const loc = (document.getElementById('mainSearchLoc')?.value || 'all').toLowerCase();

  const filtered = products.filter(p => {
    const matchesKeyword = !keyword ||
      p.title.toLowerCase().includes(keyword) ||
      p.description.toLowerCase().includes(keyword) ||
      p.category.toLowerCase().includes(keyword);

    const matchesCat = cat === 'all' || p.catKey === cat || (cat === 'cameras' && p.catKey === 'photography');
    const matchesLoc = loc === 'all' || p.location.toLowerCase().includes(loc);

    return matchesKeyword && matchesCat && matchesLoc;
  });

  renderListings(filtered);
};

window.resetFilters = () => {
  const kw = document.getElementById('mainSearchKeyword');
  if (kw) kw.value = '';
  const cat = document.getElementById('mainSearchCat');
  if (cat) cat.value = 'all';
  const loc = document.getElementById('mainSearchLoc');
  if (loc) loc.value = 'all';

  document.querySelectorAll('.cat-btn').forEach(b => b.classList.toggle('active', b.dataset.cat === 'all'));
  document.querySelectorAll('.category-card').forEach(c => c.classList.remove('active'));

  renderListings(products);
};

window.selectCategory = (catKey) => {
  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.cat === catKey);
  });
  document.querySelectorAll('.category-card').forEach(card => {
    card.classList.toggle('active', card.dataset.cat === catKey);
  });

  const catSelect = document.getElementById('mainSearchCat');
  if (catSelect) catSelect.value = catKey;

  window.filterMarketplace();
  document.getElementById('marketplace')?.scrollIntoView({ behavior: 'smooth' });
};

// Filter pill click listeners
document.querySelectorAll('.cat-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    window.selectCategory(btn.dataset.cat);
  });
});

// Category card click listeners
document.querySelectorAll('.category-card').forEach(card => {
  card.addEventListener('click', () => {
    window.selectCategory(card.dataset.cat);
  });
});

// Live filter on search inputs
document.getElementById('mainSearchKeyword')?.addEventListener('input', window.filterMarketplace);
document.getElementById('mainSearchCat')?.addEventListener('change', window.filterMarketplace);
document.getElementById('mainSearchLoc')?.addEventListener('change', window.filterMarketplace);

// ============================================================
// LISTING DETAIL MODAL WITH INTERACTIVE BOOKING CALCULATOR
// ============================================================
const listingOverlay = document.getElementById('listingOverlay');
let currentProduct = null;
let bookingDays = 3;
let hasProtection = false;

function updateBookingCalculation() {
  if (!currentProduct) return;
  const priceNum = parseInt(currentProduct.price.replace(/[^\d]/g, '')) || 499;
  const depositNum = parseInt(currentProduct.deposit.replace(/[^\d]/g, '')) || 2500;
  const subtotal = priceNum * bookingDays;
  const protectionFee = hasProtection ? 99 : 0;
  const total = subtotal + depositNum + protectionFee;

  const stepperVal = document.getElementById('lmStepperVal');
  if (stepperVal) stepperVal.textContent = `${bookingDays} ${bookingDays === 1 ? 'day' : 'days'}`;

  const calcSubtotal = document.getElementById('lmCalcSubtotal');
  if (calcSubtotal) calcSubtotal.textContent = `₹${subtotal.toLocaleString('en-IN')}`;

  const calcDeposit = document.getElementById('lmCalcDeposit');
  if (calcDeposit) calcDeposit.textContent = `₹${depositNum.toLocaleString('en-IN')}`;

  const calcProt = document.getElementById('lmCalcProt');
  if (calcProt) calcProt.textContent = hasProtection ? '₹99' : '₹0';

  const calcTotal = document.getElementById('lmCalcTotal');
  if (calcTotal) calcTotal.textContent = `₹${total.toLocaleString('en-IN')}`;
}

window.changeDuration = (delta) => {
  bookingDays = Math.max(1, Math.min(30, bookingDays + delta));
  updateBookingCalculation();
};

window.toggleProtection = (e) => {
  hasProtection = e.target.checked;
  updateBookingCalculation();
};

function openListingModal(data) {
  if (!data || !listingOverlay) return;
  currentProduct = data;
  bookingDays = 3;
  hasProtection = false;

  const protBox = document.getElementById('lmProtectionBox');
  if (protBox) protBox.checked = false;

  const img = document.getElementById('lmImage');
  const title = document.getElementById('lmTitle');
  const location = document.getElementById('lmLocation');
  const price = document.getElementById('lmPrice');
  const desc = document.getElementById('lmDesc');
  const ownerName = document.getElementById('lmOwnerName');
  const ownerInitial = document.getElementById('lmOwnerInitial');
  const deposit = document.getElementById('lmDeposit');
  const cond = document.getElementById('lmCondition');

  if (img) img.src = data.image;
  if (title) title.textContent = data.title;
  if (location) location.textContent = data.location;
  if (price) price.textContent = data.price;
  if (desc) desc.textContent = data.description;
  if (ownerName) ownerName.textContent = data.owner;
  if (ownerInitial) ownerInitial.textContent = data.owner.charAt(0).toUpperCase();
  if (deposit) deposit.textContent = data.deposit;
  if (cond) cond.textContent = data.condition || 'Verified';

  updateBookingCalculation();

  listingOverlay.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeListingModal() {
  listingOverlay?.classList.remove('open');
  document.body.style.overflow = '';
}

listingOverlay?.addEventListener('click', (e) => {
  if (e.target === listingOverlay) closeListingModal();
});
document.getElementById('lmClose')?.addEventListener('click', closeListingModal);

// ============================================================
// LIST AN ITEM MODAL (FOR OWNERS)
// ============================================================
window.openListModal = () => {
  const modal = document.getElementById('listItemModal');
  if (modal) modal.classList.add('open');
  document.body.style.overflow = 'hidden';
};

window.closeListModal = () => {
  const modal = document.getElementById('listItemModal');
  if (modal) modal.classList.remove('open');
  document.body.style.overflow = '';
};

window.handleCreateListing = (e) => {
  e.preventDefault();
  const title = document.getElementById('newTitle')?.value.trim();
  const cat = document.getElementById('newCategory')?.value || 'tools';
  const price = document.getElementById('newPrice')?.value.trim() || '499';
  const deposit = document.getElementById('newDeposit')?.value.trim() || '2000';
  const loc = document.getElementById('newLocation')?.value.trim() || 'Bengaluru, KA';
  const desc = document.getElementById('newDesc')?.value.trim() || 'Available for rent on SkipIt.';

  const newItem = {
    id: 'item_' + Date.now(),
    title: title || 'New Rental Listing',
    category: cat.charAt(0).toUpperCase() + cat.slice(1),
    catKey: cat.toLowerCase(),
    location: loc,
    price: '₹' + price.replace(/[^\d]/g, ''),
    deposit: '₹' + parseInt(deposit.replace(/[^\d]/g, '')).toLocaleString('en-IN'),
    rating: '5.0',
    reviews: 1,
    owner: 'You (Owner)',
    image: 'images/product_camera.jpg',
    status: 'Available Now',
    condition: 'Verified Item',
    description: desc,
  };

  products.unshift(newItem);
  window._products[newItem.id] = newItem;
  renderListings(products);
  closeListModal();
  alert('🎉 Congratulations! Your item has been listed on the SkipIt marketplace.');
  document.getElementById('marketplace')?.scrollIntoView({ behavior: 'smooth' });
};

// ============================================================
// USER DASHBOARD MODAL
// ============================================================
window.openDashboardModal = () => {
  const modal = document.getElementById('userDashboardModal');
  if (modal) modal.classList.add('open');
  document.body.style.overflow = 'hidden';
};

window.closeDashboardModal = () => {
  const modal = document.getElementById('userDashboardModal');
  if (modal) modal.classList.remove('open');
  document.body.style.overflow = '';
};

window.scrollToMarketplace = () => {
  document.getElementById('marketplace')?.scrollIntoView({ behavior: 'smooth' });
};

window.executeSearch = () => {
  if (typeof window.filterMarketplace === 'function') {
    window.filterMarketplace();
  }
  window.scrollToMarketplace();
};

// Smooth anchor scrolling
document.querySelectorAll('a[href^="#"]').forEach(link => {
  link.addEventListener('click', (e) => {
    const href = link.getAttribute('href');
    if (href === '#' || !href) return;
    const target = document.querySelector(href);
    if (target) {
      e.preventDefault();
      const top = target.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top, behavior: 'smooth' });
    }
  });
});

// Check NestJS API connection asynchronously
fetch('http://localhost:3000/api/listings')
  .then(res => res.json())
  .then(json => {
    if (json?.data?.length) {
      console.log('SkipIt 2.0 API connected: ' + json.data.length + ' active listings.');
    }
  })
  .catch(() => {
    console.log('SkipIt API running in offline resilient mode.');
  });
