@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');

:root {
  /* Brand Tokens */
  --brand:               #0055ff;
  --brand-hover:         #0044cc;
  --brand-light:         rgba(0, 85, 255, 0.15);
  --brand-glow:          rgba(0, 85, 255, 0.4);
  --electric-blue:       #38bdf8;
  --electric-accent:     #60a5fa;

  /* Canvas Background */
  --bg-main:             #030508;
  --bg-surface:          #080c16;

  /* Glassmorphism System with HIGH CONTRAST */
  --glass-card:          rgba(14, 20, 36, 0.88);
  --glass-card-hover:    rgba(18, 26, 48, 0.94);
  --glass-nav:           rgba(8, 12, 24, 0.85);
  --glass-modal:         rgba(12, 17, 32, 0.96);
  --glass-input:         rgba(255, 255, 255, 0.05);
  --glass-border:        rgba(255, 255, 255, 0.09);
  --glass-border-focus:  rgba(0, 85, 255, 0.6);
  --glass-highlight:     rgba(255, 255, 255, 0.14);
  --glass-blur:          blur(16px);
  --glass-shadow:        0 16px 40px rgba(0, 0, 0, 0.45);

  /* High-Contrast Typography */
  --text-primary:        #ffffff;
  --text-secondary:      #cbd5e1;
  --text-muted:          #94a3b8;
  --text-dim:            #64748b;

  /* Status Colors */
  --green-bg:            rgba(34, 197, 94, 0.16);
  --green-border:        rgba(34, 197, 94, 0.35);
  --green-text:          #4ade80;
  --amber-bg:            rgba(245, 158, 11, 0.16);
  --amber-text:          #fbbf24;

  /* Typography */
  --font-sans:           'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-body:           'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

  /* Radii */
  --radius-sm:           8px;
  --radius-md:           12px;
  --radius-lg:           16px;
  --radius-xl:           20px;
  --radius-2xl:          28px;
  --radius-full:         9999px;

  /* Transitions */
  --ease-out:            cubic-bezier(0.16, 1, 0.3, 1);
  --duration:            240ms;
  --duration-fast:       160ms;
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--bg-main);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  position: relative;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
  font-family: inherit;
  border: none;
  background: none;
}

ul, ol {
  list-style: none;
}

.container {
  width: 100%;
  max-width: 1220px;
  margin: 0 auto;
  padding: 0 32px;
}

.section {
  padding: 96px 0;
  position: relative;
  z-index: 2;
}

/* REVEAL ANIMATIONS */
.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
}
.reveal.visible {
  opacity: 1;
  transform: none;
}
.reveal-delay-1 { transition-delay: 0.08s; }
.reveal-delay-2 { transition-delay: 0.16s; }
.reveal-delay-3 { transition-delay: 0.24s; }
.reveal-delay-4 { transition-delay: 0.32s; }
.reveal-delay-5 { transition-delay: 0.4s; }

/* AMBIENT BACKGROUND */
.ambient-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  background: radial-gradient(circle at 50% 0%, #0a1128 0%, var(--bg-main) 70%);
  overflow: hidden;
  pointer-events: none;
}
.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.4;
  animation: float-orb 22s infinite alternate ease-in-out;
}
.orb-1 {
  width: 650px;
  height: 650px;
  background: rgba(0, 85, 255, 0.16);
  top: -15%;
  right: -10%;
}
.orb-2 {
  width: 750px;
  height: 750px;
  background: rgba(30, 10, 110, 0.15);
  bottom: -20%;
  left: -15%;
  animation-delay: -6s;
}
@keyframes float-orb {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-40px, 40px) scale(1.08); }
  100% { transform: translate(40px, -30px) scale(0.92); }
}

/* REUSABLE GLASS PANEL UTILITY */
.glass-panel {
  background: var(--glass-card);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
  border-radius: var(--radius-xl);
  position: relative;
  overflow: hidden;
}
.glass-panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--glass-highlight), transparent);
}

/* BUTTONS */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 24px;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  font-weight: 600;
  line-height: 1;
  border-radius: var(--radius-full);
  transition: all var(--duration-fast) var(--ease-out);
  white-space: nowrap;
  position: relative;
  cursor: pointer;
  border: none;
}
.btn:active {
  transform: scale(0.98);
}
.btn--primary {
  background: linear-gradient(135deg, #0055ff 0%, #0044cc 100%);
  color: #ffffff;
  box-shadow: 0 4px 18px rgba(0, 85, 255, 0.45);
}
.btn--primary:hover {
  background: linear-gradient(135deg, #1a6bff 0%, #0052e6 100%);
  box-shadow: 0 6px 24px rgba(0, 85, 255, 0.6);
  transform: translateY(-1px);
}
.btn--outline {
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(8px);
}
.btn--outline:hover {
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  transform: translateY(-1px);
}
.btn--white {
  background: #ffffff;
  color: #030508;
  font-weight: 700;
  box-shadow: 0 4px 20px rgba(255, 255, 255, 0.2);
}
.btn--white:hover {
  background: #f1f5f9;
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(255, 255, 255, 0.35);
}
.btn--outline-white {
  background: transparent;
  color: #ffffff;
  border: 1.5px solid rgba(255, 255, 255, 0.3);
}
.btn--outline-white:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #ffffff;
  transform: translateY(-1px);
}
.btn--lg {
  padding: 16px 32px;
  font-size: 1rem;
  font-weight: 700;
}
.btn--sm {
  padding: 9px 18px;
  font-size: 0.8125rem;
}

/* BADGES */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 11px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.badge--green {
  background: var(--green-bg);
  border: 1px solid var(--green-border);
  color: var(--green-text);
}
.badge--blue {
  background: var(--brand-light);
  border: 1px solid rgba(0, 85, 255, 0.35);
  color: #93c5fd;
}
.badge--demo {
  background: rgba(245, 158, 11, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.3);
  color: #fcd34d;
}

/* SECTION HEADER */
.section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 56px;
}
.section-header .eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--electric-blue);
  background: var(--brand-light);
  border: 1px solid rgba(0, 85, 255, 0.25);
  padding: 5px 14px;
  border-radius: var(--radius-full);
  margin-bottom: 16px;
}
.section-header h2 {
  color: #ffffff;
  font-family: var(--font-sans);
  font-size: clamp(2rem, 3.8vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 16px;
}
.section-header p {
  color: var(--text-secondary);
  font-size: 1.0625rem;
  line-height: 1.7;
}

/* ============================================================
   NAVBAR
   ============================================================ */
#navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: var(--glass-nav);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--glass-border);
  transition: all var(--duration);
}
#navbar.scrolled {
  background: rgba(5, 8, 18, 0.95);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
  border-bottom-color: rgba(255, 255, 255, 0.12);
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 28px;
  height: 70px;
  padding: 0 32px;
  max-width: 1220px;
  margin: 0 auto;
}
.nav-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.nav-logo-icon {
  width: 38px;
  height: 38px;
  background: var(--brand);
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 10px rgba(0, 85, 255, 0.4);
}
.nav-logo-icon svg {
  width: 22px;
  height: 22px;
  fill: white;
}
.nav-logo-text {
  font-family: var(--font-sans);
  font-size: 1.4rem;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: -0.05em;
  text-transform: lowercase;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
}
.nav-link {
  font-size: 0.925rem;
  font-weight: 500;
  color: var(--text-secondary);
  padding: 8px 14px;
  border-radius: var(--radius-md);
  transition: all var(--duration-fast);
}
.nav-link:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.06);
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}
.nav-search-btn {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  transition: all var(--duration-fast);
  cursor: pointer;
}
.nav-search-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
}
.nav-login {
  font-size: 0.925rem;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 8px 14px;
  border-radius: var(--radius-md);
  transition: all var(--duration-fast);
}
.nav-login:hover {
  color: #ffffff;
}
.nav-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  width: 38px;
  height: 38px;
  padding: 8px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-md);
  border: 1px solid var(--glass-border);
}
.nav-hamburger span {
  display: block;
  width: 100%;
  height: 2px;
  background: #ffffff;
  border-radius: 2px;
  transition: all var(--duration-fast);
}

/* MOBILE NAV */
.mobile-nav {
  display: none;
  position: fixed;
  top: 70px;
  left: 0;
  right: 0;
  background: rgba(8, 12, 24, 0.98);
  backdrop-filter: blur(24px);
  border-bottom: 1px solid var(--glass-border);
  padding: 24px;
  flex-direction: column;
  gap: 16px;
  z-index: 999;
}
.mobile-nav.open {
  display: flex;
}
.mobile-nav-link {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}
.mobile-nav-link:hover {
  color: #ffffff;
}
.mobile-nav-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 8px;
}

/* ============================================================
   HERO SECTION
   ============================================================ */
#hero {
  padding-top: 130px;
  padding-bottom: 60px;
  position: relative;
  overflow: hidden;
  z-index: 2;
}
.hero-inner {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 48px;
  align-items: center;
  min-height: 520px;
}
.hero-left {
  max-width: 620px;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: rgba(0, 85, 255, 0.12);
  border: 1px solid rgba(0, 85, 255, 0.3);
  border-radius: var(--radius-full);
  font-size: 0.8125rem;
  font-weight: 600;
  color: #93c5fd;
  margin-bottom: 20px;
}
.hero-badge-dot {
  width: 8px;
  height: 8px;
  background: #3b82f6;
  border-radius: 50%;
  box-shadow: 0 0 10px #3b82f6;
}
.hero-headline {
  font-family: var(--font-sans);
  font-size: clamp(2.5rem, 5vw, 3.75rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1.1;
  color: #ffffff;
  margin-bottom: 16px;
}
.hero-headline span {
  background: linear-gradient(135deg, #ffffff 30%, #70aaff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-subheadline {
  font-family: var(--font-sans);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--electric-blue);
  margin-bottom: 14px;
  letter-spacing: -0.01em;
}
.hero-description {
  font-size: 1.0625rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 32px;
}
.hero-ctas {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 36px;
  flex-wrap: wrap;
}
.hero-trust {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}
.hero-trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-muted);
}
.hero-trust-item svg {
  width: 16px;
  height: 16px;
  color: #22c55e;
}

/* HERO RIGHT - FLOATING RENTAL CARDS */
.hero-right {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.hero-preview-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.hero-float-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  background: var(--glass-card);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  border-radius: var(--radius-xl);
  transition: all var(--duration);
}
.hero-float-card:hover {
  transform: translateY(-3px) scale(1.01);
  border-color: rgba(255, 255, 255, 0.2);
  background: var(--glass-card-hover);
}
.hero-float-img {
  width: 64px;
  height: 64px;
  border-radius: var(--radius-md);
  object-fit: cover;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.05);
}
.hero-float-info {
  flex: 1;
}
.hero-float-title {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4px;
}
.hero-float-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}
.hero-float-price {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  font-weight: 800;
  color: #ffffff;
}
.hero-float-price span {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-muted);
}
.hero-float-badge {
  margin-left: auto;
}

/* ============================================================
   INTEGRATED GLASS MARKETPLACE SEARCH BAR
   ============================================================ */
.hero-search-container {
  margin-top: 40px;
  margin-bottom: 24px;
  position: relative;
  z-index: 10;
}
.glass-search-bar {
  background: rgba(14, 20, 38, 0.94);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-2xl);
  padding: 12px 16px;
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  display: grid;
  grid-template-columns: 2fr 1.2fr 1fr auto;
  gap: 12px;
  align-items: center;
}
.search-field {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-lg);
  transition: all var(--duration-fast);
}
.search-field:focus-within {
  background: rgba(0, 85, 255, 0.08);
  border-color: var(--brand);
  box-shadow: 0 0 0 2px rgba(0, 85, 255, 0.2);
}
.search-field svg {
  width: 18px;
  height: 18px;
  color: var(--text-muted);
  flex-shrink: 0;
}
.search-field input,
.search-field select {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  font-family: var(--font-body);
  font-size: 0.925rem;
  color: #ffffff;
}
.search-field select option {
  background: #0d1222;
  color: #ffffff;
}
.search-field input::placeholder {
  color: var(--text-muted);
}
.glass-search-btn {
  padding: 14px 26px;
  background: linear-gradient(135deg, #0055ff, #0044cc);
  color: #ffffff;
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 0.9375rem;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 16px rgba(0, 85, 255, 0.45);
  transition: all var(--duration-fast);
  cursor: pointer;
  white-space: nowrap;
}
.glass-search-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(0, 85, 255, 0.6);
}

/* ============================================================
   CATEGORIES SECTION
   ============================================================ */
.category-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12px;
  margin-bottom: 48px;
}
.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 20px 12px;
  background: var(--glass-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  text-align: center;
  transition: all var(--duration);
  cursor: pointer;
}
.category-card:hover, .category-card.active {
  background: rgba(0, 85, 255, 0.18);
  border-color: rgba(0, 85, 255, 0.5);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0, 85, 255, 0.25);
}
.category-card-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7AABFF;
  transition: all var(--duration);
}
.category-card:hover .category-card-icon,
.category-card.active .category-card-icon {
  background: var(--brand);
  color: #ffffff;
}
.category-card-icon svg {
  width: 20px;
  height: 20px;
}
.category-card-title {
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 700;
  color: #ffffff;
}

/* ============================================================
   MARKETPLACE LISTINGS GRID (HIGH CONTRAST)
   ============================================================ */
.categories-filter {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 32px;
  overflow-x: auto;
  padding-bottom: 8px;
  scrollbar-width: none;
}
.categories-filter::-webkit-scrollbar {
  display: none;
}
.cat-btn {
  padding: 8px 18px;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  transition: all var(--duration-fast);
  white-space: nowrap;
  cursor: pointer;
}
.cat-btn:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}
.cat-btn.active {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
  box-shadow: 0 2px 12px rgba(0, 85, 255, 0.4);
}

.listings-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 24px;
}

/* PRODUCT CARD */
.product-card {
  background: var(--glass-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--radius-xl);
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
  overflow: hidden;
  transition: all var(--duration);
  cursor: pointer;
  display: flex;
  flex-direction: column;
}
.product-card:hover {
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.15);
  transform: translateY(-4px);
  background: var(--glass-card-hover);
}
.product-card-image {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #090e1a;
  position: relative;
}
.product-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s var(--ease-out);
}
.product-card:hover .product-card-image img {
  transform: scale(1.05);
}
.product-card-status {
  position: absolute;
  top: 12px;
  left: 12px;
}
.product-card-wishlist {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 34px;
  height: 34px;
  background: rgba(10, 14, 26, 0.7);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  transition: all var(--duration-fast);
  cursor: pointer;
}
.product-card-wishlist:hover {
  background: #ffffff;
  color: #ef4444;
  transform: scale(1.1);
}
.product-card-wishlist svg {
  width: 16px;
  height: 16px;
}
.product-card-body {
  padding: 18px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.product-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.product-card-location {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.8125rem;
  color: var(--text-muted);
}
.product-card-location svg {
  width: 13px;
  height: 13px;
}
.product-card-rating {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.8125rem;
  font-weight: 700;
  color: #ffffff;
}
.product-card-rating svg {
  width: 13px;
  height: 13px;
  color: #fbbf24;
  fill: #fbbf24;
}
.product-card-title {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12px;
  line-height: 1.35;
}
.product-card-owner {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 18px;
}
.owner-avatar {
  width: 26px;
  height: 26px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #160078, #0055ff);
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}
.product-card-owner-name {
  font-size: 0.8125rem;
  color: var(--text-secondary);
}
.owner-verified {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--green-text);
  margin-left: auto;
}
.owner-verified svg {
  width: 14px;
  height: 14px;
}
.product-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin-top: auto;
}
.product-card-price {
  display: flex;
  flex-direction: column;
}
.product-price-main {
  font-family: var(--font-sans);
  font-size: 1.25rem;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
}
.product-price-per {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-top: 2px;
}

/* ============================================================
   RENTAL WORKFLOW TIMELINE
   ============================================================ */
.workflow-section {
  position: relative;
  z-index: 2;
}
.workflow-timeline {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
  margin-top: 48px;
  position: relative;
}
.wf-step-card {
  padding: 24px 20px;
  background: var(--glass-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  position: relative;
  transition: all var(--duration);
}
.wf-step-card:hover {
  transform: translateY(-4px);
  border-color: rgba(0, 85, 255, 0.4);
  box-shadow: 0 12px 32px rgba(0, 85, 255, 0.15);
}
.wf-num {
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 800;
  color: var(--electric-blue);
  letter-spacing: 0.08em;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.wf-title {
  font-family: var(--font-sans);
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8px;
}
.wf-desc {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.55;
}

/* ============================================================
   TRUST & SAFETY SECTION
   ============================================================ */
.trust-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.trust-card {
  background: var(--glass-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--radius-xl);
  padding: 28px 24px;
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
  transition: all var(--duration);
  position: relative;
  overflow: hidden;
}
.trust-card:hover {
  transform: translateY(-3px);
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.6);
}
.trust-card-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: rgba(0, 85, 255, 0.18);
  border: 1px solid rgba(0, 85, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: #7AABFF;
}
.trust-card-icon svg {
  width: 24px;
  height: 24px;
}
.trust-card h3 {
  font-family: var(--font-sans);
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10px;
}
.trust-card p {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ============================================================
   REVENUE TRANSPARENCY SECTION
   ============================================================ */
.revenue-flow-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 24px;
  margin-top: 48px;
}
.rev-box {
  padding: 32px 28px;
  background: var(--glass-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-2xl);
  display: flex;
  flex-direction: column;
}
.rev-box-tag {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--electric-blue);
  margin-bottom: 12px;
}
.rev-box h3 {
  font-family: var(--font-sans);
  font-size: 1.35rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 14px;
}
.rev-box p {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 20px;
}
.rev-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: auto;
}
.rev-list-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.875rem;
  color: #ffffff;
}
.rev-list-item svg {
  width: 16px;
  height: 16px;
  color: #22c55e;
  flex-shrink: 0;
}
.rev-highlight-card {
  background: linear-gradient(135deg, rgba(0, 85, 255, 0.25), rgba(22, 0, 120, 0.35));
  border-color: rgba(0, 85, 255, 0.4);
}

/* ============================================================
   FOR OWNERS / RENTERS SPLIT
   ============================================================ */
.split-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.split-content h2 {
  font-family: var(--font-sans);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: #ffffff;
  margin-bottom: 16px;
}
.split-content p {
  color: var(--text-secondary);
  font-size: 1.0625rem;
  line-height: 1.7;
  margin-bottom: 32px;
}
.owner-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 32px;
}
.owner-step-item {
  padding: 16px 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  text-align: center;
}
.owner-step-num {
  font-size: 0.75rem;
  font-weight: 800;
  color: var(--electric-blue);
  margin-bottom: 4px;
}
.owner-step-label {
  font-size: 0.875rem;
  font-weight: 700;
  color: #ffffff;
}
.benefits-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 32px;
}
.benefit-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.benefit-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: rgba(0, 85, 255, 0.18);
  border: 1px solid rgba(0, 85, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #7AABFF;
}
.benefit-icon svg {
  width: 18px;
  height: 18px;
}
.benefit-text h4 {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 2px;
}
.benefit-text p {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.5;
}
.split-visual {
  background: var(--glass-card);
  backdrop-filter: blur(16px);
  border-radius: var(--radius-2xl);
  padding: 24px;
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
}
.split-visual-img {
  border-radius: var(--radius-xl);
  overflow: hidden;
  height: 280px;
}
.split-visual-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ============================================================
   PROTECTION PLANS
   ============================================================ */
.plans-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 960px;
  margin: 0 auto;
}
.plan-card {
  border-radius: var(--radius-2xl);
  padding: 36px 28px;
  border: 1px solid var(--glass-border);
  position: relative;
  background: var(--glass-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: var(--glass-shadow);
  transition: all var(--duration);
}
.plan-card--featured {
  border-color: var(--brand);
  background: linear-gradient(145deg, rgba(0, 85, 255, 0.22), rgba(15, 20, 36, 0.92));
  box-shadow: 0 0 0 3px rgba(0, 85, 255, 0.2);
}
.plan-badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--brand);
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 14px;
  border-radius: var(--radius-full);
}
.plan-tier {
  font-family: var(--font-sans);
  font-size: 1.75rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8px;
}
.plan-description {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24px;
}
.plan-features {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.plan-feature {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.875rem;
  color: var(--text-secondary);
}
.plan-feature svg {
  width: 16px;
  height: 16px;
  color: #22c55e;
  flex-shrink: 0;
  margin-top: 2px;
}

/* DEPOSIT NOTICE */
.deposit-notice {
  max-width: 680px;
  margin: 48px auto 0;
  padding: 24px 32px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  text-align: center;
}
.deposit-notice p {
  font-size: 0.9375rem;
  color: var(--text-secondary);
  line-height: 1.6;
}
.deposit-notice strong {
  color: #ffffff;
}

/* ============================================================
   COMMUNITY & CTA
   ============================================================ */
.community-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.stat-card {
  text-align: center;
  padding: 32px 24px;
  border-radius: var(--radius-xl);
  background: var(--glass-card);
  backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
  transition: all var(--duration);
}
.stat-card:hover {
  transform: translateY(-3px);
  border-color: rgba(0, 85, 255, 0.4);
}
.stat-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: rgba(0, 85, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  color: #7AABFF;
}
.stat-value {
  font-family: var(--font-sans);
  font-size: 2rem;
  font-weight: 900;
  color: #ffffff;
  margin-bottom: 4px;
}
.stat-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-secondary);
}

#cta-section {
  text-align: center;
  padding: 120px 0;
  position: relative;
  overflow: hidden;
}
#cta-section::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(0, 85, 255, 0.25) 0%, transparent 70%);
  pointer-events: none;
}
.cta-headline {
  font-family: var(--font-sans);
  font-size: clamp(2.5rem, 6vw, 3.75rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #ffffff;
  margin-bottom: 14px;
}
.cta-subtext {
  font-size: 1.25rem;
  color: var(--text-secondary);
  margin-bottom: 40px;
}
.cta-btns {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

/* ============================================================
   FOOTER
   ============================================================ */
#footer {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding: 64px 0 32px;
  position: relative;
  z-index: 2;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 48px;
}
.footer-brand-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}
.footer-tagline {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 24px;
  line-height: 1.6;
}
.footer-socials {
  display: flex;
  gap: 8px;
}
.social-btn {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  transition: all var(--duration-fast);
}
.social-btn:hover {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
}
.social-btn svg {
  width: 16px;
  height: 16px;
}
.footer-col h5 {
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 16px;
}
.footer-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.footer-link {
  font-size: 0.9rem;
  color: var(--text-muted);
  transition: color var(--duration-fast);
}
.footer-link:hover {
  color: #ffffff;
}
.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}
.footer-copy {
  font-size: 0.8125rem;
  color: var(--text-muted);
}
.footer-legal {
  display: flex;
  gap: 24px;
}
.footer-legal a {
  font-size: 0.8125rem;
  color: var(--text-muted);
}
.footer-legal a:hover {
  color: #ffffff;
}

/* ============================================================
   MODALS (HIGH CONTRAST GLASS)
   ============================================================ */
.search-overlay,
.listing-overlay,
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(3, 5, 8, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--duration);
}
.search-overlay.open,
.listing-overlay.open,
.modal-overlay.open {
  opacity: 1;
  pointer-events: all;
}

/* SEARCH MODAL */
.search-modal {
  background: var(--glass-modal);
  backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-2xl);
  width: 100%;
  max-width: 600px;
  padding: 32px;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.7);
  transform: translateY(-20px);
  transition: transform var(--duration);
}
.search-overlay.open .search-modal {
  transform: none;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--brand);
  border-radius: var(--radius-xl);
}
.search-input-wrap svg {
  color: var(--brand);
  width: 20px;
  height: 20px;
}
.search-input-wrap input {
  flex: 1;
  font-family: var(--font-body);
  font-size: 1rem;
  border: none;
  outline: none;
  background: transparent;
  color: #ffffff;
}
.search-hints {
  margin-top: 16px;
}
.search-hints p {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 8px;
  text-transform: uppercase;
}
.search-quick-cats {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.search-quick-cat {
  padding: 7px 14px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.06);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--duration-fast);
}
.search-quick-cat:hover {
  background: var(--brand-light);
  color: #ffffff;
}

/* LISTING DETAIL MODAL & BOOKING PANEL */
.listing-modal {
  background: var(--glass-modal);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-2xl);
  width: 100%;
  max-width: 900px;
  max-height: 90vh;
  overflow-y: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.8);
  position: relative;
}
.listing-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  cursor: pointer;
  z-index: 10;
  transition: all var(--duration-fast);
}
.listing-modal-close:hover {
  background: rgba(255, 255, 255, 0.2);
}
.listing-modal-image {
  background: #090e1a;
  display: flex;
  flex-direction: column;
}
.listing-modal-image img {
  width: 100%;
  height: 100%;
  max-height: 480px;
  object-fit: cover;
}
.listing-modal-body {
  padding: 32px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}
.lm-price-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin: 12px 0 16px;
}
.lm-price-main {
  font-family: var(--font-sans);
  font-size: 2.25rem;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
}
.lm-price-per {
  font-size: 0.9375rem;
  color: var(--text-muted);
}
.lm-owner-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  margin-bottom: 20px;
}
.lm-owner-avatar {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #160078, #0055ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #ffffff;
  font-size: 0.875rem;
}
.lm-owner-name {
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 0.9375rem;
  color: #ffffff;
}
.lm-owner-sub {
  font-size: 0.8125rem;
  color: var(--text-muted);
}

/* DYNAMIC BOOKING PANEL INSIDE MODAL */
.booking-calculator-panel {
  background: rgba(0, 85, 255, 0.08);
  border: 1px solid rgba(0, 85, 255, 0.25);
  border-radius: var(--radius-xl);
  padding: 20px;
  margin-bottom: 20px;
}
.booking-panel-title {
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--electric-blue);
  margin-bottom: 14px;
}
.duration-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}
.stepper-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #ffffff;
}
.stepper-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}
.stepper-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--glass-border);
  color: #ffffff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.stepper-val {
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 0.95rem;
  color: #ffffff;
  min-width: 50px;
  text-align: center;
}
.protection-checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.04);
  border-radius: var(--radius-md);
  margin-bottom: 14px;
  font-size: 0.8125rem;
  color: var(--text-secondary);
}
.protection-checkbox-row input {
  accent-color: var(--brand);
  width: 16px;
  height: 16px;
}
.calc-breakdown {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.calc-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.8125rem;
  color: var(--text-secondary);
}
.calc-row--deposit {
  color: #93c5fd;
}
.calc-row--total {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  font-weight: 800;
  color: #ffffff;
  padding-top: 8px;
  border-top: 1px dashed rgba(255, 255, 255, 0.15);
}

/* LIST AN ITEM MODAL */
.item-form-modal {
  background: var(--glass-modal);
  backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-2xl);
  width: 100%;
  max-width: 560px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 32px;
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.8);
  position: relative;
}
.item-form-modal h2 {
  font-family: var(--font-sans);
  font-size: 1.5rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 6px;
}
.item-form-modal p {
  font-size: 0.875rem;
  color: var(--text-secondary);
  margin-bottom: 24px;
}
.form-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.form-input-group {
  margin-bottom: 16px;
}
.form-input-group label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6px;
}
.form-input-group input,
.form-input-group select,
.form-input-group textarea {
  width: 100%;
  padding: 12px 14px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  color: #ffffff;
  font-family: var(--font-body);
  font-size: 0.9rem;
  outline: none;
  box-sizing: border-box;
}
.form-input-group input:focus,
.form-input-group select:focus,
.form-input-group textarea:focus {
  border-color: var(--brand);
  background: rgba(0, 85, 255, 0.08);
}
.form-input-group select option {
  background: #0e1424;
  color: #ffffff;
}

/* MOBILE CTA BAR */
.mobile-cta-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 900;
  background: rgba(8, 12, 24, 0.92);
  backdrop-filter: blur(16px);
  border-top: 1px solid var(--glass-border);
  padding: 14px 20px;
  gap: 12px;
}
.mobile-cta-bar .btn {
  flex: 1;
  justify-content: center;
}

/* ============================================================
   RESPONSIVE QUERIES
   ============================================================ */
@media (max-width: 1024px) {
  .hero-inner {
    grid-template-columns: 1fr;
    gap: 36px;
  }
  .category-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .glass-search-bar {
    grid-template-columns: 1fr 1fr;
  }
  .glass-search-btn {
    grid-column: span 2;
    justify-content: center;
  }
  .workflow-timeline {
    grid-template-columns: 1fr 1fr;
  }
  .trust-grid {
    grid-template-columns: 1fr 1fr;
  }
  .revenue-flow-grid {
    grid-template-columns: 1fr;
  }
  .split-section {
    grid-template-columns: 1fr;
  }
  .plans-grid {
    grid-template-columns: 1fr;
    max-width: 480px;
  }
  .community-stats {
    grid-template-columns: 1fr 1fr;
  }
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
  .listing-modal {
    grid-template-columns: 1fr;
    max-height: 92vh;
  }
  .listing-modal-image {
    height: 240px;
  }
}

@media (max-width: 768px) {
  .container {
    padding: 0 20px;
  }
  .nav-links, .nav-actions {
    display: none;
  }
  .nav-hamburger {
    display: flex;
    margin-left: auto;
  }
  .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .glass-search-bar {
    grid-template-columns: 1fr;
  }
  .glass-search-btn {
    grid-column: span 1;
  }
  .workflow-timeline {
    grid-template-columns: 1fr;
  }
  .trust-grid {
    grid-template-columns: 1fr;
  }
  .community-stats {
    grid-template-columns: 1fr;
  }
  .footer-grid {
    grid-template-columns: 1fr;
  }
  .mobile-cta-bar {
    display: flex;
  }
  body {
    padding-bottom: 70px;
  }
}
