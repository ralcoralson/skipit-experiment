<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>skipit — Access over ownership. Rent smarter.</title>
  <meta name="description" content="SkipIt is a peer-to-peer rental marketplace where you can rent premium cameras, tools, consoles, and outdoor gear from verified people nearby. Skip buying. Rent smarter.">
  <meta name="theme-color" content="#0055ff">
  <meta property="og:title" content="skipit — Access over ownership. Rent smarter.">
  <meta property="og:description" content="Peer-to-peer rental marketplace. Rent what you need, earn from what you own.">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/svg+xml" href="images/favicon.svg">
  <link rel="stylesheet" href="styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>

<!-- Ambient Atmospheric Glow Orbs -->
<div class="ambient-bg">
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>
</div>

<!-- ============================================================
     SEARCH MODAL (KEYBOARD SHORTCUT CMD+K)
     ============================================================ -->
<div class="search-overlay" id="searchOverlay" role="dialog" aria-label="Search Marketplace">
  <div class="search-modal">
    <form id="searchForm">
      <div class="search-input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input id="searchInput" type="text" placeholder="Search cameras, laptops, tools, PS5..." autocomplete="off">
      </div>
    </form>
    <div class="search-hints">
      <p>Popular searches</p>
      <div class="search-quick-cats">
        <button class="search-quick-cat">Sony Camera</button>
        <button class="search-quick-cat">PlayStation 5</button>
        <button class="search-quick-cat">Power Drill</button>
        <button class="search-quick-cat">Mini Projector</button>
        <button class="search-quick-cat">Camping Tent</button>
        <button class="search-quick-cat">Mountain Bike</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     LISTING DETAIL MODAL WITH INTERACTIVE BOOKING CALCULATOR
     ============================================================ -->
<div class="listing-overlay" id="listingOverlay" role="dialog" aria-label="Listing detail">
  <div class="listing-modal">
    <button class="listing-modal-close" id="lmClose" aria-label="Close modal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="listing-modal-image">
      <img id="lmImage" src="" alt="Product view">
    </div>
    <div class="listing-modal-body">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap">
        <span class="badge badge--green">
          <svg viewBox="0 0 8 8" fill="currentColor" style="width:7px;height:7px"><circle cx="4" cy="4" r="3"/></svg>
          Available Now
        </span>
        <span class="badge badge--blue" id="lmCondition">Like New</span>
      </div>

      <h2 id="lmTitle" style="font-family:var(--font-sans);font-size:1.45rem;font-weight:800;letter-spacing:-.025em;line-height:1.25;margin-bottom:6px;color:#ffffff"></h2>

      <div style="display:flex;align-items:center;gap:6px;font-size:.875rem;color:var(--text-muted);margin-bottom:12px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="lmLocation"></span>
      </div>

      <div class="lm-price-row">
        <span class="lm-price-main" id="lmPrice"></span>
        <span class="lm-price-per">/ day</span>
        <span class="badge badge--demo" style="margin-left:auto">Refundable Deposit: <strong id="lmDeposit" style="margin-left:4px">₹0</strong></span>
      </div>

      <p id="lmDesc" style="font-size:.9rem;color:var(--text-secondary);line-height:1.65;margin-bottom:18px"></p>

      <!-- Owner Info -->
      <div class="lm-owner-row">
        <div class="lm-owner-avatar" id="lmOwnerInitial">R</div>
        <div>
          <div class="lm-owner-name" id="lmOwnerName"></div>
          <div class="lm-owner-sub">Verified owner · 98% Trust Score</div>
        </div>
        <div style="margin-left:auto;display:flex;align-items:center;gap:4px;font-size:.8125rem;font-weight:600;color:var(--green-text)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          KYC Verified
        </div>
      </div>

      <!-- DYNAMIC BOOKING CALCULATOR -->
      <div class="booking-calculator-panel">
        <div class="booking-panel-title">Rental Booking Summary</div>

        <div class="duration-stepper">
          <span class="stepper-label">Rental Duration:</span>
          <div class="stepper-controls">
            <button class="stepper-btn" onclick="changeDuration(-1)">-</button>
            <span class="stepper-val" id="lmStepperVal">3 days</span>
            <button class="stepper-btn" onclick="changeDuration(1)">+</button>
          </div>
        </div>

        <label class="protection-checkbox-row">
          <input type="checkbox" id="lmProtectionBox" onchange="toggleProtection(event)">
          <span>Add Standard Damage Protection (<strong>+₹99</strong>)</span>
        </label>

        <div class="calc-breakdown">
          <div class="calc-row">
            <span>Rental Fee:</span>
            <strong id="lmCalcSubtotal">₹0</strong>
          </div>
          <div class="calc-row calc-row--deposit">
            <span>Refundable Deposit (Escrow):</span>
            <strong id="lmCalcDeposit">₹0</strong>
          </div>
          <div class="calc-row">
            <span>Damage Protection:</span>
            <strong id="lmCalcProt">₹0</strong>
          </div>
          <div class="calc-row calc-row--total">
            <span>Estimated Total:</span>
            <strong id="lmCalcTotal">₹0</strong>
          </div>
        </div>
      </div>

      <div style="background:rgba(255,255,255,.04);border:1px solid var(--glass-border);border-radius:var(--radius-lg);padding:12px 14px;font-size:.8rem;color:var(--text-secondary);margin-bottom:18px;line-height:1.5">
        <strong style="color:#ffffff">🛡️ Escrow Guarantee:</strong> Security deposit is held separately in escrow and 100% refunded to you upon safe item return. It is never platform revenue.
      </div>

      <button class="btn btn--primary btn--lg" style="width:100%;justify-content:center" onclick="checkAuthThenRent()">
        Continue to Rent
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:16px;height:16px"><path d="m5 12h14M12 5l7 7-7 7"/></svg>
      </button>
      <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:10px">Pickup and return coordinated directly with owner per rental agreement.</p>
    </div>
  </div>
</div>

<!-- ============================================================
     LIST AN ITEM MODAL (FOR OWNERS)
     ============================================================ -->
<div class="modal-overlay" id="listItemModal" role="dialog" aria-label="List an Item">
  <div class="item-form-modal">
    <button class="listing-modal-close" onclick="closeListModal()" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h2>List an Item for Rent</h2>
    <p>Monetize your unused gear. Set your daily price and start earning.</p>

    <form onsubmit="handleCreateListing(event)">
      <div class="form-input-group">
        <label>Item Name / Title</label>
        <input type="text" id="newTitle" placeholder="e.g. Sony A7 III Mirrorless Camera" required>
      </div>

      <div class="form-grid-2">
        <div class="form-input-group">
          <label>Category</label>
          <select id="newCategory">
            <option value="cameras">Cameras</option>
            <option value="tools">Tools</option>
            <option value="electronics">Electronics</option>
            <option value="gaming">Gaming</option>
            <option value="camping">Camping</option>
            <option value="sports">Sports</option>
            <option value="events">Events</option>
          </select>
        </div>
        <div class="form-input-group">
          <label>City / Location</label>
          <input type="text" id="newLocation" placeholder="e.g. Bengaluru, KA" required>
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-input-group">
          <label>Price per Day (₹)</label>
          <input type="number" id="newPrice" placeholder="599" required min="50">
        </div>
        <div class="form-input-group">
          <label>Refundable Deposit (₹)</label>
          <input type="number" id="newDeposit" placeholder="4000" required min="0">
        </div>
      </div>

      <div class="form-input-group">
        <label>Item Description &amp; What's Included</label>
        <textarea id="newDesc" rows="3" placeholder="Condition, included accessories, cables, batteries, etc."></textarea>
      </div>

      <button type="submit" class="btn btn--primary btn--lg" style="width:100%;justify-content:center;margin-top:10px">
        Publish Listing Now
      </button>
    </form>
  </div>
</div>

<!-- ============================================================
     USER DASHBOARD MODAL
     ============================================================ -->
<div class="modal-overlay" id="userDashboardModal" role="dialog" aria-label="User Dashboard">
  <div class="item-form-modal" style="max-width:620px">
    <button class="listing-modal-close" onclick="closeDashboardModal()" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h2>User Dashboard</h2>
    <p>Manage your peer-to-peer rentals, escrow deposits, and listings.</p>

    <div style="display:flex;align-items:center;gap:14px;padding:16px;background:rgba(255,255,255,.05);border:1px solid var(--glass-border);border-radius:var(--radius-xl);margin-bottom:24px">
      <div style="width:48px;height:48px;border-radius:50%;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.25rem;font-weight:800" id="dashAvatar">U</div>
      <div>
        <div style="font-weight:700;font-size:1.05rem;color:#ffffff" id="dashName">SkipIt Member</div>
        <div style="font-size:.85rem;color:var(--text-muted)" id="dashEmail">user@example.com</div>
      </div>
      <div style="margin-left:auto">
        <span class="badge badge--green">✓ KYC Verified</span>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px">
      <div style="padding:16px;background:rgba(255,255,255,.04);border-radius:var(--radius-lg);border:1px solid var(--glass-border)">
        <div style="font-size:.75rem;color:var(--text-muted);text-transform:uppercase">Active Rentals</div>
        <div style="font-size:1.5rem;font-weight:800;color:#ffffff;margin-top:4px">1 Item</div>
      </div>
      <div style="padding:16px;background:rgba(255,255,255,.04);border-radius:var(--radius-lg);border:1px solid var(--glass-border)">
        <div style="font-size:.75rem;color:var(--text-muted);text-transform:uppercase">Escrow Safe Balance</div>
        <div style="font-size:1.5rem;font-weight:800;color:var(--green-text);margin-top:4px">₹5,000</div>
      </div>
    </div>

    <div style="display:flex;gap:12px">
      <button class="btn btn--primary" style="flex:1;justify-content:center" onclick="closeDashboardModal(); openListModal();">
        + List New Item
      </button>
      <button class="btn btn--outline" style="flex:1;justify-content:center" onclick="logoutUser()">
        Sign Out
      </button>
    </div>
  </div>
</div>

<!-- ============================================================
     MOBILE STICKY CTA
     ============================================================ -->
<div class="mobile-cta-bar">
  <a href="#marketplace" class="btn btn--outline btn--sm">Explore Rentals</a>
  <button class="btn btn--primary btn--sm" onclick="openListModal()">List an Item</button>
</div>

<!-- ============================================================
     NAVBAR (FLOATING GLASSNAVBAR)
     ============================================================ -->
<nav id="navbar" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="#hero" class="nav-logo" aria-label="SkipIt home">
      <div class="nav-logo-icon">
        <svg viewBox="0 0 38 38" fill="white" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 6C4 4.895 4.895 4 6 4H24C25.105 4 26 4.895 26 6V15H16C14.895 15 14 15.895 14 17V26H6C4.895 26 4 25.105 4 24V6Z"/>
          <rect x="17" y="17" width="17" height="9" rx="2"/>
          <circle cx="10" cy="32" r="4"/><circle cx="24" cy="32" r="4"/>
        </svg>
      </div>
      <span class="nav-logo-text">skipit</span>
    </a>
    <div class="nav-links">
      <a href="#marketplace" class="nav-link">Explore</a>
      <a href="#categories-section" class="nav-link">Categories</a>
      <a href="#how-it-works" class="nav-link">How It Works</a>
      <a href="#trust" class="nav-link">Safety &amp; Trust</a>
      <a href="#for-owners" class="nav-link">For Owners</a>
    </div>
    <div class="nav-actions">
      <button class="nav-search-btn js-open-search" aria-label="Search" id="navSearchBtn" title="Search (Cmd+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
      <a href="auth.html" class="nav-login" id="navLoginBtn">Log in</a>
      <div id="navUserMenu" style="display:none;align-items:center;gap:10px">
        <div id="navAvatar" onclick="openDashboardModal()" style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg, #0055ff, #0044cc);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;cursor:pointer;border:1px solid rgba(255,255,255,0.2)" title="My Account Dashboard"></div>
        <button onclick="logoutUser()" style="font-size:13px;font-weight:600;color:var(--text-secondary);background:none;border:none;cursor:pointer;padding:0">Sign out</button>
      </div>
      <button class="btn btn--primary btn--sm" onclick="openListModal()">List an Item</button>
    </div>
    <button class="nav-hamburger" id="hamburger" aria-label="Open mobile menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile Nav Panel -->
<div class="mobile-nav" id="mobileNav">
  <div class="mobile-nav-links">
    <a href="#marketplace" class="mobile-nav-link">Explore Rentals</a>
    <a href="#categories-section" class="mobile-nav-link">Categories</a>
    <a href="#how-it-works" class="mobile-nav-link">How It Works</a>
    <a href="#trust" class="mobile-nav-link">Safety &amp; Trust</a>
    <a href="#for-owners" class="mobile-nav-link">For Owners</a>
    <a href="#revenue" class="mobile-nav-link">Pricing &amp; Escrow</a>
  </div>
  <div class="mobile-nav-actions">
    <a href="auth.html" class="btn btn--outline" style="justify-content:center">Log in</a>
    <button class="btn btn--primary" style="justify-content:center" onclick="openListModal()">List an Item</button>
  </div>
</div>

<main>

<!-- ============================================================
     1. HERO SECTION (WITH EXACT MASTER SPECIFICATION)
     ============================================================ -->
<section id="hero" aria-label="Hero Section">
  <div class="container">
    <div class="hero-inner">
      <!-- Left Content -->
      <div class="hero-left">
        <div class="hero-badge reveal">
          <div class="hero-badge-dot"></div>
          Peer-to-Peer Rental Marketplace · India
        </div>
        <h1 class="hero-headline reveal reveal-delay-1">
          Why buy it when you can <span>SkipIt?</span>
        </h1>
        <p class="hero-subheadline reveal reveal-delay-2">
          Rent what you need. Use it when you need it. Return it when you're done.
        </p>
        <p class="hero-description reveal reveal-delay-3">
          SkipIt is a peer-to-peer rental marketplace that connects you with verified owners nearby. Access high-value cameras, power tools, gaming consoles, and gear at a fraction of ownership cost.
        </p>
        <div class="hero-ctas reveal reveal-delay-4">
          <a href="#marketplace" class="btn btn--primary btn--lg" id="hero-explore-btn">
            Explore Rentals
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:16px;height:16px"><path d="m5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button class="btn btn--outline btn--lg" id="hero-list-btn" onclick="openListModal()">
            List an Item
          </button>
        </div>
        <div class="hero-trust reveal reveal-delay-5">
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Verified Owners
          </div>
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Escrow Security Deposits
          </div>
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Damage Protection Plans
          </div>
        </div>
      </div>

      <!-- Right Content: Floating Rental Cards (Prompt Requirements) -->
      <div class="hero-right reveal reveal-delay-2">
        <div class="hero-preview-stack">
          <!-- Card 1: Pressure Washer -->
          <div class="hero-float-card" onclick="scrollToMarketplace()">
            <img class="hero-float-img" src="images/product_drill.jpg" alt="Pressure washer">
            <div class="hero-float-info">
              <div class="hero-float-title">Commercial Pressure Washer</div>
              <div class="hero-float-meta">
                <div class="hero-float-price">₹350 <span>/ day</span></div>
                <span class="badge badge--green">✓ Verified</span>
              </div>
            </div>
            <div class="hero-float-badge">
              <span class="badge badge--demo">Visual Demo</span>
            </div>
          </div>

          <!-- Card 2: Sony Alpha Camera -->
          <div class="hero-float-card" onclick="openListingModal(window._products['camera'])">
            <img class="hero-float-img" src="images/product_camera.jpg" alt="Sony Alpha Camera">
            <div class="hero-float-info">
              <div class="hero-float-title">Sony Alpha Mirrorless Camera</div>
              <div class="hero-float-meta">
                <div class="hero-float-price">₹450 <span>/ day</span></div>
                <div style="display:flex;align-items:center;gap:3px;font-size:.8rem;font-weight:700;color:#fbbf24">
                  ★ 4.9 <span style="color:var(--text-muted);font-weight:400">(34)</span>
                </div>
              </div>
            </div>
            <div class="hero-float-badge">
              <span class="badge badge--green">Available</span>
            </div>
          </div>

          <!-- Card 3: Camping Kit -->
          <div class="hero-float-card" onclick="openListingModal(window._products['tent'])">
            <img class="hero-float-img" src="images/product_tent.jpg" alt="Camping Kit">
            <div class="hero-float-info">
              <div class="hero-float-title">Complete 4-Person Camping Kit</div>
              <div class="hero-float-meta">
                <div class="hero-float-price">₹600 <span>/ day</span></div>
                <span class="badge badge--green">✓ Verified</span>
              </div>
            </div>
            <div class="hero-float-badge">
              <span class="badge badge--demo">Visual Demo</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         INTEGRATED GLASS MARKETPLACE SEARCH BAR
         ============================================================ -->
    <div class="hero-search-container reveal reveal-delay-3">
      <div class="glass-search-bar">
        <!-- What do you need? -->
        <div class="search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" id="mainSearchKeyword" placeholder="What do you need? (e.g. Camera, PS5, Drill)" autocomplete="off">
        </div>

        <!-- Location -->
        <div class="search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <select id="mainSearchLoc">
            <option value="all">All Locations (India)</option>
            <option value="Bengaluru">Bengaluru, KA</option>
            <option value="Mumbai">Mumbai, MH</option>
            <option value="Delhi">Delhi, DL</option>
            <option value="Pune">Pune, MH</option>
            <option value="Hyderabad">Hyderabad, TS</option>
            <option value="Chennai">Chennai, TN</option>
            <option value="Jaipur">Jaipur, RJ</option>
          </select>
        </div>

        <!-- Category -->
        <div class="search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <select id="mainSearchCat">
            <option value="all">All Categories</option>
            <option value="tools">Tools</option>
            <option value="cameras">Cameras</option>
            <option value="electronics">Electronics</option>
            <option value="camping">Camping</option>
            <option value="gaming">Gaming</option>
            <option value="sports">Sports</option>
            <option value="events">Events</option>
          </select>
        </div>

        <!-- Search Button -->
        <button class="glass-search-btn" onclick="executeSearch()">
          Search Rentals
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:16px;height:16px"><path d="m5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     2. CATEGORY SYSTEM (SECTION 11)
     ============================================================ -->
<section id="categories-section" class="section" style="padding-top:40px;padding-bottom:40px" aria-label="Marketplace Categories">
  <div class="container">
    <div class="category-grid reveal">
      <div class="category-card" data-cat="tools">
        <div class="category-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <span class="category-card-title">Tools</span>
      </div>

      <div class="category-card" data-cat="cameras">
        <div class="category-card-icon">
